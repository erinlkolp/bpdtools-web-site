---
import Base from '../layouts/Base.astro';
import PhoneMockup from '../components/PhoneMockup.astro';

const title = 'bpdtools — a private app for logging emotions';
const description =
  'A private, offline Android app for logging emotions as they happen. A logging tool, not treatment.';

const privacy = [
  {
    h: 'Sync is off until you turn it on',
    p: `With it off, entries live only on your device, in an app-private
        database no other app can read.`,
  },
  {
    h: 'The app can reach the network',
    p: `Earlier versions declared no internet permission at all, so Android
        itself would refuse to open a socket even if a bug tried. That
        guarantee is gone. What replaces it is weaker: one compiled-in
        destination (api.bpdtools.cloud), cleartext traffic disabled, and a switch that is off
        until you turn it on. That is policy enforced by this app's code,
        where before it was enforced by Android regardless of this app's
        code. It is worth knowing which of those you have.`,
  },
  {
    h: 'Sync brought in more than one permission',
    p: `Alongside internet access, the background scheduler adds network-state,
        wake-lock, boot-completed and foreground-service permissions, and
        Android may add local-network access at install. Android Settings
        lists seven, not one — worth knowing before you go looking. None of
        them read anything on the device, and with sync off nothing is
        scheduled for them to do.`,
  },
  {
    h: 'The first sync uploads everything',
    p: `If you turn sync on, the first upload is everything: every entry,
        including what you wrote in "What happened?", and including entries
        logged long before sync existed. Each one is sealed on the phone before
        it leaves. Nothing has ever been marked as synced, so the first
        successful upload is your entire history. The app tells you this, and
        the exact entry count, before it happens.`,
  },
  {
    h: 'Entries are encrypted end to end',
    p: `The phone seals the emotion, the intensity, the coping skills and the
        trigger note together under AES-256-GCM, with a 32-byte key that never
        leaves your device, before any of it is sent. The server stores a blob
        it has no key for: nobody with access to that machine can read what you
        wrote — not with administrator access, not from a disk snapshot, not
        from the offsite backup. What it can still see is the public metadata:
        the entry's id, when it was recorded, created and last updated, whether
        it is a deletion, and when it arrived. Timing, not content. That
        metadata is bound to the sealed blob rather than merely filed beside
        it, so a server that reordered your entries, backdated one, or
        un-flipped a deletion would fail the next decrypt rather than manage it
        quietly.`,
  },
  {
    h: 'Turning sync off does not delete what was already sent',
    p: `There is no delete endpoint, so the app cannot make one. Removing data
        from the server is done on the server.`,
  },
  {
    h: 'Deleting an entry does not unsend it',
    p: `Once an entry has synced, deleting it on the phone does not remove the
        row from the server. The row is kept there as a tombstone so that a
        restore is faithful, but its payload stays sealed — the server cannot
        read what was deleted any more than it could read it before. Clearing
        the app's storage does not reach it.`,
  },
  {
    h: 'No account, no login, no telemetry, no analytics',
    p: `Nothing about your usage is collected or reported. There are two
        secrets, and you paste in both yourself: the sync token, and the
        encryption key that seals your entries.`,
  },
  {
    h: "Android's cloud backup is disabled",
    p: `The app declares backup off, and an explicit rules file excludes the
        database, the preferences, and every other file domain. The only
        upload is the one you switch on, to one address you can name.`,
  },
  {
    h: 'Device-to-device transfer is deliberately left on',
    p: `It copies your entries straight from an old phone to a new one without
        touching a server. Neither of your secrets comes across — the token and
        the encryption key are both wrapped with a key held in the Android
        Keystore, and those keys do not transfer. You paste both in again on
        the new phone.`,
  },
  {
    h: 'Deleting your data',
    p: `Deleting an entry hides it from the app — it stops appearing anywhere
        in the interface. The row itself is kept as a tombstone so that sync
        can report the deletion. To remove the data from the phone, clear
        bpdtools's storage in Android Settings, or uninstall the app.`,
  },
];
---
<Base title={title} description={description}>
  <header class="hero">
    <div class="wrap">
      <img
        class="hero-logo"
        src="/logo.png"
        width="680"
        height="327"
        alt="bpdtools"
        fetchpriority="high"
      />
      <h1 class="hero-lede">
        A private, offline Android app for logging emotions as they happen —
        what you felt, how strongly, what prompted it, and what you did about
        it.
      </h1>
      <p class="hero-claim">It is a logging tool, not treatment.</p>
      <p class="hero-status">
        bpdtools is not publicly distributed yet. There is nothing to download
        from this page.
      </p>
    </div>
  </header>

  <section class="section" aria-labelledby="what">
    <div class="wrap section-head">
      <h2 id="what">What it does</h2>
      <p class="section-lede">
        Three screens, and nothing it does not need.
      </p>
    </div>

    <div class="wrap features">
      <article class="feature-card reveal">
        <h3 class="feature-title">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
          Log
        </h3>
        <p>
          Pick an emotion, set an intensity from 0 to 10, add an optional note
          on what triggered it, tag any coping skills you used, and adjust the
          timestamp if you are logging after the fact. Saving resets the form
          in place, so logging several entries in a row is fast.
        </p>
        <PhoneMockup
          name="log"
          label="The Log screen: a grid of emotion buttons with Anger selected, an intensity of 7 above a slider, a note reading &quot;Left on read again.&quot;, and a row of coping-skill buttons."
        />
      </article>

      <article class="feature-card reveal">
        <h3 class="feature-title">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          History
        </h3>
        <p>
          Everything you have logged, most recent first, grouped by day. Tap an
          entry to edit it. Deleting offers an Undo — a visible button rather
          than a swipe, because a swipe is invisible to a screen reader and
          would leave some people with no way to discover it.
        </p>
        <PhoneMockup
          name="history"
          label="The History screen: entries grouped by day under Today, Yesterday and earlier dates, each row showing an emotion, an intensity out of ten, and a delete button."
        />
      </article>

      <article class="feature-card reveal">
        <h3 class="feature-title">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
          Trends
        </h3>
        <p>
          Three views over the last 7 days, 30 days, or all time: mean
          intensity per day, your most frequent emotions, and average intensity
          for each one. The intensity axis is pinned to 0–10 rather than
          auto-scaled, and every chart has a plain-text equivalent beneath it.
        </p>
        <PhoneMockup
          name="trends"
          label="The Trends screen: a 7 days, 30 days and all time selector, a line chart of intensity over time with each day's figure written out beneath it, and lists of the most frequent emotions and their average intensities."
        />
      </article>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="privacy">
    <div class="wrap section-head">
      <h2 id="privacy">Where your entries go</h2>
      <p class="section-lede">
        This is a mental-health-adjacent app, so it comes before anything else —
        including the parts that are not flattering.
      </p>
    </div>
    <div class="wrap wrap--wide">
      <dl class="privacy">
        {privacy.map((item) => (
          <div class="privacy-item reveal">
            <dt>{item.h}</dt>
            <dd>{item.p}</dd>
          </div>
        ))}
      </dl>
      <p class="note">
        This is exactly what the app's own About screen says. If this page and
        that screen ever disagree, that is a bug.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="isnt">
    <div class="wrap closing">
      <h2 id="isnt">What it isn't</h2>
      <p>
        bpdtools gives no advice, no diagnosis, and no suggestions. It does not
        interpret what you log, score it, or tell you what to do about it. It
        records what you tell it and helps you look back at it later.
      </p>
      <p>
        The coping-skill vocabulary is drawn from Dialectical Behaviour Therapy.
        Naming a skill is not recommending it.
      </p>
      <p class="hero-claim">It is a logging tool, not treatment.</p>
    </div>
  </section>
</Base>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          // Optional: stop observing once revealed
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => {
    observer.observe(el);
  });
</script>
